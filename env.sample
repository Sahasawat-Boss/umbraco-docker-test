# Copy this file to `.env` before running `docker compose up`.
# `.env` itself is gitignored because these are secrets.

# Password for the self-signed dev certificate the entrypoint generates into ./certs.
CERT_PASSWORD=choose-a-password

# Key used to sign image-processing URLs. Generate a fresh random value, e.g.
#   openssl rand -hex 32
HMAC_SECRET_KEY=replace-with-a-random-64-char-hex-string
